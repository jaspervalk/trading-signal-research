# Copy to .env and fill in.

# --- LLM ---
ANTHROPIC_API_KEY=

# Only required if you set transcript.whisper_backend=openai_api in settings.yaml.
OPENAI_API_KEY=

# --- YouTube ---
# YOUTUBE_API_KEY is optional. Phase 1 uses yt-dlp + youtube-transcript-api,
# which do not require a key. Set this only if/when we move to the official Data API.
YOUTUBE_API_KEY=

# --- Storage ---
# SQLite path is relative to repo root.
DATABASE_URL=sqlite:///data/tsr.sqlite

# --- App ---
LOG_LEVEL=INFO
ENV=dev
